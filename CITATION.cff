  metadata below.
title: >-
  PDMS Elastomer: Coarse-Grained PDMS Elastomer Generation and Analysis
  Workflow
type: software
authors:
  - family-names: Zhang
    given-names: Siteng
repository-code: https://github.com/sitengz/PDMS_Elastomer
